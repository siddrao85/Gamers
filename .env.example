# Copy to .env and edit:  cp .env.example .env

# --- GPU access (/dev/dri) ---
# Find the right numbers on your server with:
#   getent group video render
VIDEO_GID=44
RENDER_GID=993

# --- Ollama ---
OLLAMA_VULKAN=1          # 1 = use Radeon 680M via Vulkan, 0 = CPU only
OLLAMA_KEEP_ALIVE=10m    # unload model from RAM after this much idle time

# --- Open WebUI ---
# Generate with:  openssl rand -hex 32
WEBUI_SECRET_KEY=change-me
WEBUI_ENABLE_SIGNUP=true # set to false after creating your admin account

# --- Jellyfin ---
PUID=1000                # your user id   (run: id -u)
PGID=1000                # your group id  (run: id -g)
TZ=Etc/UTC               # e.g. America/New_York, Asia/Kolkata
MEDIA_PATH=/srv/media    # folder holding your movies/shows/music
JELLYFIN_URL=            # optional, e.g. http://192.168.1.50:8096
